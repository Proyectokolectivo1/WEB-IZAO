# syntax=docker/dockerfile:1.7
# Contexto de construcción: raíz del repositorio.
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.25.0 --activate
WORKDIR /repo

FROM base AS build
ENV NEXT_TELEMETRY_DISABLED=1 CI=true
COPY . .
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
RUN pnpm --filter @izao/web build

FROM node:22-alpine AS runner
ENV NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 PORT=3000 HOSTNAME=0.0.0.0 \
    NODE_OPTIONS=--max-old-space-size=1536
WORKDIR /app
RUN addgroup -S izao && adduser -S izao -G izao
COPY --from=build --chown=izao:izao /repo/apps/web/.next/standalone ./
COPY --from=build --chown=izao:izao /repo/apps/web/.next/static ./apps/web/.next/static
# Si existe apps/web/public se copia en la Oleada 2 (la tienda); hoy no hay carpeta.
USER izao
EXPOSE 3000
HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=5 \
  CMD node -e "fetch('http://127.0.0.1:3000/api/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"
CMD ["node", "apps/web/server.js"]
