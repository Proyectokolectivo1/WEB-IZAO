# syntax=docker/dockerfile:1.7
# Contexto de construcción: raíz del repositorio.
FROM node:22-alpine AS base
RUN corepack enable && corepack prepare pnpm@10.25.0 --activate
WORKDIR /repo

FROM base AS build
ENV CI=true
COPY . .
RUN --mount=type=cache,id=pnpm,target=/root/.local/share/pnpm/store \
    pnpm install --frozen-lockfile
RUN pnpm --filter @izao/worker build \
 && pnpm --filter @izao/worker deploy --legacy --prod /out

FROM node:22-alpine AS runner
ENV NODE_ENV=production NODE_OPTIONS=--max-old-space-size=768 TZ=America/Bogota
WORKDIR /app
RUN addgroup -S izao && adduser -S izao -G izao
COPY --from=build --chown=izao:izao /out/node_modules ./node_modules
COPY --from=build --chown=izao:izao /out/package.json ./package.json
COPY --from=build --chown=izao:izao /repo/apps/worker/dist ./dist
USER izao
HEALTHCHECK --interval=20s --timeout=5s --start-period=15s --retries=3 \
  CMD node -e "const s=require('fs').statSync('/tmp/worker-alive');process.exit(Date.now()-s.mtimeMs<60000?0:1)" || exit 1
CMD ["node", "dist/index.js"]
