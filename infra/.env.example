# Plantilla de variables (§28). SIN valores: copiar a infra/.env y completar.
# Formato: una línea CLAVE=VALOR. Cron lo carga con run-with-env.sh (texto literal) y Docker
# Compose con su propio lector, que NO coinciden con $, # o espacios sin comillas. Regla: todo valor
# que tenga $, # o espacios va entre COMILLAS SIMPLES, p. ej. SMTP_PASS='pa$$ w#rd'. Con comillas
# simples ambos lectores dan el mismo valor; run-with-env.sh avisa (sin imprimir el valor) si
# encuentra $, " #" o espacios sin ellas. Una comilla simple dentro del valor no se puede escapar:
# evítala al generar contraseñas.
# En el VPS el .env real vive en /srv/izao/app/infra/.env con permisos 600.
# Las credenciales comerciales (Wompi, Addi, WhatsApp, MasterShop, OpenRouter...)
# NO van aquí: se cargan cifradas desde el panel.

NODE_ENV=
APP_URL=
SUPABASE_URL=
SUPABASE_PROJECT_REF=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
DATABASE_URL=
REDIS_URL=
APP_ENCRYPTION_KEY=
AGENT_TOKEN_PEPPER=
MEDIA_ROOT=
MEDIA_PUBLIC_URL=
MASTERSHOP_WEBHOOK_PATH_SECRET=
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
MAXMIND_DB_PATH=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
ADMIN_ALERT_EMAIL=
ADMIN_ALERT_WHATSAPP=
SENTRY_DSN=
# Cifrado de backups (OBLIGATORIO): solo la llave PÚBLICA va en el VPS; la privada se guarda fuera.
BACKUP_AGE_RECIPIENT=
BACKUP_GPG_RECIPIENT=
# Opcional: monitor "push" de Uptime Kuma para alertas de backup/base/disco
UPTIME_PUSH_URL=
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_KEY=
BACKUP_S3_SECRET=

# --- Operación de Compose (no son secretos) ---
# IZAO_DATA_DIR=          # local: ./data ; VPS: /srv/izao
# IZAO_TAG=
# WEB_REPLICAS=           # VPS: 2
# WEB_PORT_RANGE=
# UPTIME_PORT=
# NGINX_HTTP_PORT=
