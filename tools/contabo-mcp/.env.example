# Copia este archivo como tools/contabo-mcp/.env y llénalo. Nunca lo subas a git.

# ---- SSH al VPS (obligatorio) ----
VPS_HOST=169.58.102.153
VPS_PORT=22
VPS_USER=izao
# Ruta absoluta a la llave privada creada para Claude Code (Windows: C:/Users/TU_USUARIO/.ssh/izao_claude_code)
VPS_SSH_KEY_PATH=
VPS_SSH_KEY_PASSPHRASE=
# Huella ed25519 del servidor que imprime setup-vps.sh (formato SHA256:...)
VPS_HOST_KEY_SHA256=

# ---- Política ----
# restricted (recomendado) u open (solo lista de bloqueo)
VPS_POLICY=restricted
VPS_PROJECT_DIR=/srv/izao
VPS_COMPOSE_PROJECT=izao
# VPS_SCRIPTS_DIR=/srv/izao/app/infra/scripts
# VPS_WRITE_ROOTS=/srv/izao,/tmp/izao
# VPS_READ_ROOTS=/srv/izao,/tmp/izao,/etc/nginx,/var/log/nginx,/etc/letsencrypt/renewal
# VPS_CURL_ALLOWED_HOSTS=localhost,127.0.0.1,izaoperfumeria.com,www.izaoperfumeria.com
# VPS_DEFAULT_TIMEOUT_SEC=120
# VPS_MAX_TIMEOUT_SEC=1800

# ---- API de Contabo (opcional: snapshots e información de la instancia) ----
# Panel de Contabo → API: Client ID, Client Secret, API User (tu correo) y API Password
CONTABO_CLIENT_ID=
CONTABO_CLIENT_SECRET=
CONTABO_API_USER=
CONTABO_API_PASSWORD=
# ID numérico de la instancia (panel de Contabo o contabo_instance con all=true)
CONTABO_INSTANCE_ID=
# 1 para permitir encender/apagar/reiniciar el VPS (afecta a todos los proyectos). Recomendado: 0
CONTABO_ALLOW_POWER_ACTIONS=0
