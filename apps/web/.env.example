# Variables del panel /admin (nombres de la sección 28 de la especificación).
# Copia este archivo como .env.local y completa los valores. Nunca subas .env.local a git.

# URL del proyecto de Supabase (wyxjmlgrcjclelbrluvd).
SUPABASE_URL=
# Llave publicable (o anon). Es pública por diseño.
SUPABASE_PUBLISHABLE_KEY=
# Llave secreta (o service_role). Solo servidor: da acceso total a la base.
SUPABASE_SECRET_KEY=
# 32 bytes en base64. Se genera con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=
