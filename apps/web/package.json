{
  "name": "@izao/web",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node .next/standalone/apps/web/server.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test -c tests/playwright.config.ts",
    "test:e2e:humo": "playwright test -c tests/playwright.config.ts e2e/humo datos/",
    "test:a11y": "playwright test -c tests/playwright.config.ts a11y/",
    "lighthouse": "lhci autorun --config=tests/lighthouse/lighthouserc.cjs",
    "crear-admin": "tsx --env-file=.env.local scripts/crear-admin.ts"
  },
  "dependencies": {
    "@izao/core": "workspace:*",
    "@izao/ui": "workspace:*",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "motion": "^12.0.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
